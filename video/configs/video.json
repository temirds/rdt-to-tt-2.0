{
  "video": {
    "env_path": ".env",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 20,
    "preset": "veryfast",
    "backgrounds_dir": "../input",
    "cache_dir": "cache",
    "background_usage_db_path": "cache/background_usage.sqlite3",
    "fonts_dir": "fonts",
    "music_dir": "music",
    "sfx_dir": "sfx",
    "music_volume": 0.04,
    "sfx_volume": 1.3,
    "tail_seconds": 1.5,
    "ffmpeg_path": "ffmpeg",
    "ffprobe_path": "ffprobe",
    "default_output_dir": "../out",
    "min_background_seconds": 8.0
  },
  "backgrounds": {
    "default_tags": ["satisfying", "driving", "city", "nature"],
    "tags": {
      "minecraft": [],
      "subway": [],
      "satisfying": [],
      "driving": [],
      "cooking": [],
      "nature": [],
      "city": [],
      "fitness": []
    },
    "urls": []
  },
  "style": {
    "font_name": "Exo 2 Black",
    "question_font_size": 96,
    "answer_font_size": 96,
    "text_margin_v": 260,
    "text_margin_h": 90,
    "subtitle_outline": 8,
    "subtitle_shadow": 2,
    "word_seconds": 0.55,
    "word_timestamps": true,
    "whisper_model": "base",
    "whisper_language": ""
  }
}
